# =============================
# علي بابا — FREE LAUNCH
# =============================
# Free-launch mode disables metered AI and demo payments by design.
FREE_LAUNCH_MODE=1

# Required: use a stable random value (32+ bytes) in production.
SECRET_KEY=replace-with-a-long-random-secret

# PostgreSQL connection string. Use a free-tier PostgreSQL provider if available.
DATABASE_URL=postgresql://user:password@host:5432/database
DB_POOL_MIN=1
DB_POOL_MAX=3

# HTTPS on production; use 0 only for local http development.
SESSION_COOKIE_SECURE=1

# Admin account(s), comma separated.
ADMIN_EMAILS=you@example.com

# Optional free Google login (Google OAuth itself has no per-login fee).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Keep these OFF in free launch. They are intentionally ignored while FREE_LAUNCH_MODE=1.
AI_VERIFICATION_ENABLED=0
AI_ASSISTANT_ENABLED=0
OPENAI_API_KEY=

# NEVER enable in public production. This is only a local testing switch.
ENABLE_DEMO_PAYMENTS=0
